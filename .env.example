# One Market V10 — variables PUBLIQUES du navigateur
# Copier vers .env.local, puis renseigner les valeurs du projet Supabase onemarket.
# Ne jamais ajouter de service_role, mot de passe DB ou clé privée dans VITE_*.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
