# One Market — variables publiques côté navigateur
# Copier ce fichier vers .env.local et remplacer les valeurs.
#
# IMPORTANT : ne jamais mettre SUPABASE_SERVICE_ROLE_KEY, mot de passe,
# token privé EmailJS ou clé secrète de paiement dans une variable VITE_.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Réservé à une future intégration EmailJS côté frontend si elle est retenue.
# Les valeurs publiques uniquement peuvent être exposées avec VITE_.
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ORDER_ID=
# VITE_EMAILJS_PUBLIC_KEY=
